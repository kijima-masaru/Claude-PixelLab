# =====================================================================
# .gitattributes
# =====================================================================

# 改行は LF に統一する（Godot / Windows / macOS 混在環境での差分ノイズ防止）
* text=auto eol=lf

# ---------------------------------------------------------------------
# バイナリ既定
#   下の LFS 行にマッチしない PNG は「ただのバイナリ」として扱う。
#   LFS には入れない。
# ---------------------------------------------------------------------
*.png binary
*.aseprite binary
*.ase binary

# ---------------------------------------------------------------------
# テキストとして管理するもの（LFS 対象外）
# ---------------------------------------------------------------------
*.jsonl text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.gpl   text eol=lf
*.hex   text eol=lf

# ---------------------------------------------------------------------
# Git LFS — 完成品 PNG のみ
#   対象は projects/<project_id>/assets/ 配下の PNG に限定する。
#   広い *.png パターンは使わない。.gitignore を一度でも誤ると
#   中間生成物（_work/）が LFS に流入し、帯域と容量を枯渇させるため。
#   このパターンでは _work/ も refs/ も構造上マッチしない。
# ---------------------------------------------------------------------
projects/*/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
